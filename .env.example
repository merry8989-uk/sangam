# ---- Root / docker-compose shared env ----
# Copy to .env and fill in. NEVER commit real secrets.

# Postgres
POSTGRES_USER=sangam
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=sangam

# Redis
REDIS_PASSWORD=change-me-in-prod

# MinIO / S3-compatible object storage (India region in prod)
# ---- Object storage ----
# Everything here is S3-compatible and nothing more (PutObject, GetObject,
# DeleteObject, a presigned URL), so the backend is a configuration choice.
# lib/storage.ts resolves which one from these values and reports whether the
# bytes leave India.

# Local development: the MinIO in docker-compose.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=sangam-minio
S3_SECRET_KEY=change-me-in-prod
S3_BUCKET_MEDIA=sangam-media

# --- Option A: stay in India ---
# Leave S3_ENDPOINT empty and set a region, or point S3_ENDPOINT at an Indian
# provider (E2E EOS, NxtGen). This is the only option that keeps the
# "India-hosted" claim true for media.
#   S3_ENDPOINT=
#   S3_REGION=ap-south-1

# --- Option B: Cloudflare R2 ---
# Zero egress fees, on every storage class, which for a video platform is the
# difference between a bill that scales with views and one that does not.
#
# Read this before choosing it: R2 has NO India storage jurisdiction. The
# guaranteed jurisdictions are eu, us, fedramp and fedramp-high. The location
# hints (apac, and others) are documented by Cloudflare as "best effort and not
# a guarantee", so they are not something a residency obligation can rest on.
#
# India's DPDP Act 2023 does not require in-country storage - section 16(1) is a
# blocklist, not a residency mandate, so transfer is allowed unless the
# government restricts a country by notification. So this is a decision about a
# promise rather than about the law. Set R2_ACCOUNT_ID and the app will use it
# and say plainly in its logs that media is outside India.
#   R2_ACCOUNT_ID=your_cloudflare_account_id
#   R2_JURISDICTION=            # optional: eu | us | fedramp | fedramp-high
#   S3_ACCESS_KEY=<R2 access key id>
#   S3_SECRET_KEY=<R2 secret access key>
#   S3_PUBLIC_ENDPOINT=https://media.example.com   # an R2 custom domain or CDN

# Moderation ML models (opt-in; needs the extra deps in apps/ai/requirements-ml.txt)
MODERATION_ENABLED=false
MODERATION_TEXT_MODEL=unitary/multilingual-toxic-xlm-roberta
MODERATION_IMAGE_MODEL=Falconsai/nsfw_image_detection

# Embeddings for agent knowledge-base retrieval (opt-in, same deps as moderation)
EMBEDDINGS_ENABLED=false
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Shared secret for internal job endpoints (counter flush, scheduler)
INTERNAL_SECRET=generate-a-long-random-string

# Media enrichment queue worker (apps/worker). true = durable queue,
# false = in-process background task.
MEDIA_QUEUE_ENABLED=false

# Optional: point the AI service at a separate (GPU) inference service
ML_INFERENCE_URL=

# Meilisearch (optional). Set MEILISEARCH_URL to use it for search;
# leave blank to fall back to Postgres.
MEILISEARCH_URL=
MEILISEARCH_KEY=change-me-in-prod

# Alerting: where error-budget alerts are posted (Slack/Discord webhook)
ALERT_WEBHOOK_URL=

# Signing key for the Android app's Bearer tokens (falls back to NEXTAUTH_SECRET)
MOBILE_TOKEN_SECRET=

# LiveKit - the self-hosted media server behind calls, meetings and live streams.
# Start it with:  docker compose --profile live up
# LIVEKIT_URL is what clients connect to; LIVEKIT_API_URL is the in-network address.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_at_least_32_chars

# Encrypts connected-account credentials at rest (falls back to NEXTAUTH_SECRET).
SECRETS_KEY=

# Encrypts backup documents before they are uploaded. Falls back to
# SECRETS_KEY, then NEXTAUTH_SECRET. Keep it stable: if it changes, existing
# server-key backups can no longer be opened.
BACKUP_KEY=

# Terabox. The official OAuth device-code flow only turns on when Terabox has
# issued you a client id and secret through their integration programme
# (terabox.com/integrations). Without these, the drive offers the unofficial
# session-token path instead.
TERABOX_CLIENT_ID=
TERABOX_CLIENT_SECRET=
TERABOX_PRIVATE_SECRET=
TERABOX_API_BASE=https://www.terabox.com

# Zoho WorkDrive. Unlike Terabox, Zoho's OAuth is self-serve: register a client
# at https://api-console.zoho.in and you get a client id and secret right away.
# ZOHO_DC=in keeps everything on the India data centre.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_DC=in
ZOHO_REDIRECT_URI=

# Google Drive, the other backup target. Create an OAuth client in the Google
# Cloud console (type: Web application) and add .../api/google/callback as a
# redirect URI. Scope used is drive.file, so we only touch files we create.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Sarvam AI (powers the in-app chat / Indus experience) - server-side only
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# Diagnostics
# Where a user's "Send to support" report is addressed. Left blank, the email
# button is hidden and only Download / Send without email are offered.
#
# Deliberately an environment value rather than a constant in the code: a
# support address in the source would be published with it, and a personal
# address would then be scraped. Set it to whichever address you want reports
# to arrive at - a shared inbox is a good idea, so a report is not the only
# copy and does not sit in one person's mailbox.
DIAGNOSTICS_SUPPORT_EMAIL=

# Optional. When set, a submitted report is also POSTed here as JSON, so it can
# land in a ticket system or a channel instead of only in the database.
DIAGNOSTICS_WEBHOOK_URL=

# Sending the report as an email, with the report attached.
#
# A mailto link and a Gmail compose URL can fill in the recipient, subject and
# body, but neither can carry a file - the URI schemes have no field for one. So
# if the report must arrive attached with no step from the user, the server has
# to send it. That is what these four values turn on.
#
# EMAIL_PROVIDER is one of: resend | sendgrid | postmark | brevo | custom
# All of them are called with plain fetch, so there is no mail dependency.
# Without these, the app falls back to the share sheet and to Gmail compose.
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Must be an address the provider has verified, or it will refuse the send.
EMAIL_FROM=
# Only for EMAIL_PROVIDER=custom: the endpoint to POST the report to.
EMAIL_API_URL=


# App
# Shown in a diagnostics report and in the UI, so a report can be tied to a
# build. Set it from your release tag or CI run.
APP_VERSION=0.1.0

# ---- Logging ----
# The floor. Records below this are dropped at the call site, so a TRACE can be
# left in the code without costing anything in production.
#   TRACE | DEBUG | INFO | WARN | ERROR | FATAL
LOG_LEVEL=INFO

# Which application wrote a line: web, ai, worker. Lets one stream be told from
# another without a join.
APP_ID=web
# production | staging | development. Recorded on every line.
APP_ENV=development

# Write every record before returning, instead of batching. Slower, and the
# right choice where an instance can be frozen between requests (serverless),
# because a batch that has not flushed is lost when the instance goes.
LOG_SYNC=false

# Mirror records to stdout. Defaults to on outside production, where it is
# usually off because the platform collects stdout separately.
LOG_CONSOLE=

# How long each category is kept, in days, as JSON. Unlisted categories keep
# the defaults in apps/web/src/lib/logger.ts. A category set to 0 is kept
# forever. Enforced by POST /api/internal/prune-logs.
LOG_RETENTION_JSON=

# A second copy of every record, somewhere that survives a database outage.
# Posted as newline-delimited JSON, which is what most log services ingest
# (Loki, Datadog, Better Stack, an OpenTelemetry collector). Best effort and off
# the request path: a collector that is slow or down must not slow the app.
# Leave empty to write only to Postgres.
LOG_COLLECTOR_URL=
# Sent as `Authorization: Bearer <token>` when set.
LOG_COLLECTOR_TOKEN=

# ---- Analytics and crash reports ----
# These are collected as diagnostics logs, not in a separate system: one table
# holds both, so "what broke" and "what the user was doing" are one query. See
# docs/EVENTS.md for the schema and the rules.
#
# Consent lives on the account, not here: UserSettings.analyticsEnabled, which
# defaults to FALSE. Diagnostics defaults to true because a user asks for it;
# analytics does not, and DPDP wants consent for that difference.
#
# The schema version is declared in apps/web/src/lib/events.ts and checked in CI
# by tools/check-events.py.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string
AI_SERVICE_URL=http://ai:8000

# OTP / SMS (India: MSG91, Gupshup, Kaleyra, etc.) - leave blank for dev
SMS_PROVIDER=
SMS_API_KEY=
