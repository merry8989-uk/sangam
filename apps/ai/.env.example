# Copy to .env for local (non-Docker) runs of the AI service.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=sangam-minio
S3_SECRET_KEY=change-me-in-prod
S3_BUCKET_MEDIA=sangam-media
S3_REGION=ap-south-1

# Get a key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b
