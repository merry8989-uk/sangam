// Sangam data model (starter).
// Postgres in India (ap-south-1 / Delhi / Mumbai). See docs/ARCHITECTURE.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  username      String    @unique
  displayName   String
  passwordHash  String?
  bio           String?
  avatarUrl     String?
  coverUrl      String?
  role          Role      @default(USER)
  isVerified    Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  stories       Story[]
  following     Follow[]  @relation("follower")
  followers     Follow[]  @relation("followee")
  notifications Notification[] @relation("recipient")
  agent         Agent?
  chatSessions  ChatSession[]
  conversations ConversationParticipant[]
  directMessages DirectMessage[]
  bookmarks     Bookmark[]
  blocking      Block[]    @relation("blocker")
  blockedBy     Block[]    @relation("blocked")
  muting        Mute[]     @relation("muter")
  mutedBy       Mute[]     @relation("muted")
  reports       Report[]
  groupsOwned   Group[]
  groupMembers  GroupMember[]
  settings      UserSettings?
  viewHistory   ViewHistory[]

  skipSegments  SkipSegment[]
  skipVotes     SkipVote[]
  roomsOwned    Room[]
  roomParticipations RoomParticipant[]
  driveItems    DriveItem[]
  linkedAccounts LinkedAccount[]

  @@index([username])
}

enum Role {
  USER
  CREATOR
  MODERATOR
  ADMIN
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ---------- Social graph ----------
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followeeId  String
  status      FollowStatus @default(ACCEPTED)
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee    User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

// ---------- Content ----------
model Post {
  id         String     @id @default(cuid())
  authorId   String
  caption    String?
  visibility Visibility @default(PUBLIC)
  type       PostType   @default(IMAGE)
  status     PostStatus @default(PROCESSING)
  groupId    String?
  // denormalised counters (kept in sync by the app / background workers)
  likeCount  Int        @default(0)
  commentCount Int      @default(0)
  viewCount  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media      Media[]
  comments   Comment[]
  likes      Like[]
  hashtags   PostHashtag[]
  group      Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  bookmarks  Bookmark[]
  stats      PostStat[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([groupId, createdAt])
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum PostType {
  IMAGE
  VIDEO
  SHORT
  TEXT
}

enum PostStatus {
  PROCESSING
  READY
  FAILED
  REMOVED
}

model Media {
  id         String    @id @default(cuid())
  postId     String?
  storyId    String?
  ownerId    String
  kind       MediaKind
  // object-storage key in the India-region bucket
  storageKey String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  durationMs Int?
  thumbnailKey String?
  // HLS master playlist key for videos
  hlsKey     String?
  // Short muted preview clip for hover previews
  previewKey String?
  // Rendition ladder for videos: [{height,width,bitrateK,playlistKey}]
  renditions Json      @default("[]")
  createdAt  DateTime  @default(now())

  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  story      Story?    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  skipSegments SkipSegment[]

  @@index([postId])
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

model Story {
  id        String   @id @default(cuid())
  authorId  String
  caption   String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media     Media[]
  @@index([expiresAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
}

model Hashtag {
  id     String @id @default(cuid())
  tag    String @unique
  posts  PostHashtag[]
}

model PostHashtag {
  postId    String
  hashtagId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  @@id([postId, hashtagId])
}

// ---------- Notifications ----------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

// ---------- Moderation ----------
model ModerationFlag {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  reason     String
  score      Float?
  source     String   @default("ai")
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}

// ---------- AI agents & chat ----------
model Agent {
  id             String   @id @default(cuid())
  userId         String   @unique   // ONE agent per user, enforced by the unique index
  name           String   @default("My agent")
  model          String   @default("sarvam-105b")
  systemPrompt   String   @default("")
  temperature    Float    @default(0.7)
  skills         Json     @default("[]")
  knowledgeBase  Json     @default("[]")
  scheduledTasks Json     @default("[]")
  connectors     Json     @default("[]")
  apiKey         String   @unique   // used by external callers of the Agent API
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions ChatSession[]
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  agentId   String?
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ---------- Direct messaging ----------
model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------- Bookmarks, blocking, reports, groups ----------
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model Mute {
  id        String   @id @default(cuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  entityType String
  entityId   String
  reason     String
  note       String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model Group {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  ownerId     String
  visibility  GroupVisibility @default(PUBLIC)
  createdAt   DateTime        @default(now())

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  posts   Post[]

  @@index([createdAt])
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

// ---------- Analytics ----------
// Daily rollup of post views, written by the counter flush job. This is the
// analytics store: Post.viewCount is the running total, PostStat is the trend.
model PostStat {
  id     String   @id @default(cuid())
  postId String
  day    DateTime @db.Date
  views  Int      @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, day])
  @@index([day])
}

// ---------- Alerting ----------
model Alert {
  id           String   @id @default(cuid())
  slo          String
  severity     String
  message      String
  value        Float    @default(0)
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---------- Per-user settings ----------
model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Appearance
  theme            String  @default("system")  // system | light | dark
  accent           String  @default("orange")
  dailyBackground  Boolean @default(false)     // rotate the background daily
  backgroundMode   String  @default("static")  // static | weekly | daily | custom
  customBackground String  @default("")        // DIY colour / gradient / image key
  chatBackground   String  @default("")        // DM wallpaper
  themeMode        String  @default("daily")   // daily | weekly | monthly | yearly | mood | custom
  themeId          String  @default("")        // when themeMode = custom
  moodThemeEnabled Boolean @default(false)     // let content mood pick the family

  // Playback & quality
  videoQuality    String  @default("auto")     // auto | 1080 | 720 | 480 | 360
  audioQuality    String  @default("auto")     // auto | high | medium | low
  uploadQuality   String  @default("original")
  autoplay        Boolean @default(true)
  playbackSpeed   Float   @default(1)
  captionsDefault Boolean @default(false)
  pipEnabled      Boolean @default(true)       // picture-in-picture
  backgroundPlay  Boolean @default(false)      // audio only, video hidden
  sponsorSkip     Boolean @default(false)      // auto-skip community skip points

  // Posts & media
  defaultVisibility String  @default("PUBLIC") // PUBLIC | FOLLOWERS | PRIVATE
  allowDownloads    Boolean @default(true)

  // Recommended content
  recommendedContent Boolean    @default(true)
  interests          Json       @default("[]")
  nonInterests       Json       @default("[]")
  feedResetAt        DateTime?

  // Comments
  threadedComments Boolean @default(true)      // Reddit-style branches
  commentSort      String  @default("top")     // top | new | old

  // Sharing & visibility
  whoCanComment   String  @default("EVERYONE") // EVERYONE | FOLLOWERS | NOBODY
  whoCanShare     String  @default("EVERYONE")
  whoCanReshare   String  @default("EVERYONE")
  profileVisible  Boolean @default(true)
  whoCanViewPosts String  @default("PUBLIC")   // PUBLIC | FOLLOWERS | PRIVATE

  // Bookmarks & saving
  autoSaveDrafts Boolean @default(true)

  // History
  historyEnabled Boolean @default(true)
  autoDeleteDays Int     @default(0)           // 0 = never

  skipCategories Json    @default("[]") // empty = all categories

  // Calls, meetings & live
  callRingtone       String  @default("classic")
  callVibrate        Boolean @default(true)
  whoCanCallMe       String  @default("FOLLOWERS") // EVERYONE | FOLLOWERS | NOBODY
  callAutoAnswer     Boolean @default(false)
  dndEnabled         Boolean @default(false)
  dndFrom            String  @default("22:00")
  dndTo              String  @default("07:00")
  callDefaultCamera  String  @default("front")     // front | back
  callStartWithMic   Boolean @default(true)
  callStartWithVideo Boolean @default(true)
  noiseSuppression   Boolean @default(true)
  mirrorOwnVideo     Boolean @default(true)
  blurBackground     Boolean @default(false)
  virtualBackground  String  @default("")
  screenShareAudio   Boolean @default(true)

  // Meetings
  joinMuted          Boolean @default(true)
  joinVideoOff       Boolean @default(false)
  meetingLayout      String  @default("grid")      // grid | speaker | sidebar
  meetingMaxTiles    Int     @default(9)
  waitingRoom        Boolean @default(true)
  allowGuests        Boolean @default(false)
  meetingRecording   Boolean @default(false)

  // Live
  liveDefaultTitle   String  @default("")
  liveChatEnabled    Boolean @default(true)
  liveQaEnabled      Boolean @default(false)
  liveAutoRecord     Boolean @default(false)
  liveLatencyMode    String  @default("low")       // low | high
  liveFilterChat     Boolean @default(true)
  liveWhoCanChat     String  @default("EVERYONE")  // EVERYONE | FOLLOWERS | NOBODY

  // Moderation
  hideSensitive Boolean @default(false)
  blockedWords  Json    @default("[]")

  updatedAt DateTime @updatedAt
}

model ViewHistory {
  id       String   @id @default(cuid())
  userId   String
  postId   String
  viewedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, viewedAt])
}

// Community and personal skip points for a video (SponsorBlock-style).
// visibility SELF  -> only the author's own player skips it
// visibility EVERYONE -> anyone with "skip nonsense parts" on skips it
model SkipSegment {
  id         String   @id @default(cuid())
  mediaId    String
  authorId   String
  startSec   Float
  endSec     Float
  // NONSENSE | INTRO | OUTRO | SPONSOR | SELF_PROMO | MUSIC | FILLER
  category   String   @default("NONSENSE")
  // SELF | EVERYONE
  visibility String   @default("SELF")
  upvotes    Int      @default(0)
  downvotes  Int      @default(0)
  createdAt  DateTime @default(now())

  media      Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes      SkipVote[]

  @@index([mediaId, visibility])
  @@index([authorId])
}

// One vote per user per segment, so scores cannot be inflated by repeats.
model SkipVote {
  id        String   @id @default(cuid())
  segmentId String
  userId    String
  value     Int      // 1 or -1
  createdAt DateTime @default(now())

  segment   SkipSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([segmentId, userId])
  @@index([userId])
}

// One table for calls, meetings and live streams. Each maps to a LiveKit room,
// so a single self-hosted media server backs all three.
model Room {
  id             String   @id @default(cuid())
  kind           String   // CALL | MEETING | LIVE
  name           String
  ownerId        String
  joinCode       String   @unique
  status         String   @default("ACTIVE")   // ACTIVE | ENDED
  visibility     String   @default("PRIVATE")  // PRIVATE | FOLLOWERS | PUBLIC

  // Live only
  isLive         Boolean  @default(false)
  rtmpUrl        String?
  hlsPlaybackUrl String?
  ingressId      String?
  peakViewers    Int      @default(0)

  startedAt      DateTime @default(now())
  endedAt        DateTime?
  createdAt      DateTime @default(now())

  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  participants   RoomParticipant[]

  @@index([kind, status])
  @@index([ownerId])
}

model RoomParticipant {
  id       String    @id @default(cuid())
  roomId   String
  userId   String
  role     String    @default("VIEWER")  // HOST | SPEAKER | VIEWER
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

// A personal drive: folders, uploaded files, and documents you create in the
// app (notes, sheets, docs, slides). One tree per user.
model DriveItem {
  id         String    @id @default(cuid())
  ownerId    String
  parentId   String?
  // FOLDER | FILE | NOTE | SHEET | DOC | SLIDES | LINK
  kind       String
  name       String
  mimeType   String    @default("")
  sizeBytes  Int       @default(0)
  storageKey String?
  // NOTE / DOC / SLIDES hold markdown; SHEET holds a JSON grid.
  content    String    @default("")
  // For kind = LINK: where the item points (an imported Terabox share link).
  sourceUrl  String?
  starred    Boolean   @default(false)
  trashedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent     DriveItem?  @relation("DriveTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   DriveItem[] @relation("DriveTree")

  @@index([ownerId, parentId])
  @@index([ownerId, kind])
  @@index([ownerId, trashedAt])
}

// A third-party account a user has connected (Terabox today; the shape is
// generic so Zoho or others can reuse it). The credential is stored
// encrypted and is never sent back to any client.
model LinkedAccount {
  id           String    @id @default(cuid())
  userId       String
  provider     String    // TERABOX | ...
  label        String    @default("")
  status       String    @default("LINKED")  // LINKED | ERROR | REVOKED
  // AES-256-GCM ciphertext. Empty when the link is OAuth-only.
  secretCipher String    @default("")
  // How the link was made: OAUTH | SESSION_TOKEN
  method       String    @default("SESSION_TOKEN")
  meta         Json      @default("{}")
  linkedAt     DateTime  @default(now())
  lastUsedAt   DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}
