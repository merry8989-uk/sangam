# The API the app talks to.
#
# Android emulator -> the host machine is 10.0.2.2, not localhost: localhost on
# the device is the device itself.
# A physical device -> your machine's LAN address, e.g. http://192.168.1.20:3000
# A deployed server -> the real URL, over HTTPS.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Which release this build is, recorded on every event so a beta problem is not
# mistaken for a production one. production | beta | development
EXPO_PUBLIC_RELEASE_CHANNEL=development
